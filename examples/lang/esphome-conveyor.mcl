# Run the mgmt + ESPHome conveyor demonstration with native, encrypted API
# control. mgmt owns the desired conveyor and status-light state; ESPHome owns
# GPIO/I2C details and the safety rules that must still work without mgmt.
#
# This is a development-bench example, not a machine-safety system. Before
# energizing a motor, review the real board pinout and DRV8833 wiring, add a
# current limit and guards, and wire a physical emergency stop in series with
# the motor supply or driver enable. A software stop is not an emergency stop.
# Keep hands, hair, clothing, and loose parts clear of the belt.
#
# Copy the commented firmware below into esphome-conveyor.yaml. It targets the
# actual bench hardware tested by the accompanying CircuitPython programs:
#
#   Unexpected Maker FeatherS2:
#     ESPHome board: um_feathers2
#     MCU: ESP32-S2
#   DRV8833:
#     AIN1: CircuitPython board.D21 -> FeatherS2 GPIO38
#     AIN2: CircuitPython board.D20 -> FeatherS2 GPIO33
#     SLP:  CircuitPython board.D5  -> FeatherS2 GPIO1
#   TCA9548A:
#     SDA: CircuitPython board.SDA -> FeatherS2 GPIO8
#     SCL: CircuitPython board.SCL -> FeatherS2 GPIO9
#     address: 0x70
#   APDS9960 sensors:
#     entry sensor: TCA9548A channel 0, address 0x39, proximity only
#     exit sensor:  TCA9548A channel 1, address 0x39, proximity and RGBC
#   FeatherS2 onboard APA102:
#     data:  GPIO40
#     clock: GPIO45
#
# Color calibration notes:
#   The exact FeatherS2 and exit APDS9960 were bench-tested with proximity and
#   color enabled together, gesture disabled, 4x color gain, and 72 integration
#   cycles (about 200ms). Red and blue LEGO samples separated reliably once the
#   object was close to the sensor. Green and yellow are intentionally reported
#   as unknown until more calibration data is collected.
#
#   ESPHome's APDS9960 component reports each color channel as ADC/65535*100,
#   not as an RGB mixture, and currently initializes ATIME to 0xDB (about 103ms).
#   The boot lambda below overrides the exit sensor ATIME to 0xB8, matching the
#   successful 72-cycle CircuitPython test. mgmt normalizes R/G/B by R+G+B
#   before applying the conservative red/blue classification thresholds.
#
# Put wifi_ssid and wifi_password in ESPHome's secrets.yaml, replace the public
# sample API key in both files, then validate before flashing:
#
#   esphome config esphome-conveyor.yaml
#   esphome run esphome-conveyor.yaml
#
# Run mgmt after a human has inspected the bench and released the physical stop:
#
#   mgmt run --tmp-prefix lang examples/lang/esphome-conveyor.mcl
#
# Firmware targets the ESPHome 2026.7.0 component schemas:
#
# esphome:
#   name: esphome-conveyor
#   friendly_name: mgmt ESPHome Conveyor
#   on_boot:
#     priority: -100
#     then:
#       # Keep DRV8833 asleep before touching the H-bridge state.
#       - output.turn_off: motor_sleep
#       - fan.turn_off: conveyor_motor
#       - light.turn_off: status_light
#       # ESPHome currently sets APDS9960 ATIME=0xDB (~103ms). The bench test
#       # that cleanly separated red and blue used 72 x 2.78ms ~= 200ms, which
#       # corresponds to ATIME=256-72=184=0xB8. Apply that only to the exit
#       # sensor after the APDS9960 component has completed setup.
#       - lambda: |-
#           if (!id(exit_apds).write_byte(0x81, 0xB8)) {
#             ESP_LOGW("conveyor", "Failed to set exit APDS9960 color integration to 200ms");
#           } else {
#             ESP_LOGI("conveyor", "Exit APDS9960 color integration set to 200ms");
#           }
#
# esp32:
#   board: um_feathers2
#   variant: esp32s2
#   flash_size: 16MB
#   framework:
#     type: esp-idf
#
# wifi:
#   ssid: !secret wifi_ssid
#   password: !secret wifi_password
#   ap:
#     ssid: "esphome-conveyor-fallback"
#     password: "purpleIdea"
#     ap_timeout: 5min
#
# captive_portal:
#
# logger:
#   level: DEBUG
#
# api:
#   id: native_api
#   encryption:
#     # Public demo key. Generate a unique key for every real device.
#     key: "kJ7hc0lJ0Zw9N3DcJzXn1kJ7hc0lJ0Zw9N3DcJzXn1k="
#   reboot_timeout: 5min
#
# ota:
#   - platform: esphome
#
# # The fault latch survives a reboot. Only the explicit reset button clears
# # it; neither an API reconnect nor a repeated fan command auto-resumes motion.
# globals:
#   - id: motor_fault
#     type: bool
#     restore_value: yes
#     initial_value: "false"
#
# # FeatherS2 STEMMA/Qwiic I2C pins used by CircuitPython board.SDA/board.SCL.
# i2c:
#   - id: main_i2c
#     sda: GPIO8
#     scl: GPIO9
#     scan: true
#
# tca9548a:
#   - id: sensor_mux
#     i2c_id: main_i2c
#     address: 0x70
#     channels:
#       - bus_id: entry_i2c
#         channel: 0
#       - bus_id: exit_i2c
#         channel: 1
#
# # Keep a 100ms polling interval so proximity remains responsive. The exit
# # APDS9960 runs proximity and color together, exactly as in the successful
# # CircuitPython experiment. No gesture entities are configured.
# apds9960:
#   - id: entry_apds
#     i2c_id: entry_i2c
#     address: 0x39
#     update_interval: 100ms
#   - id: exit_apds
#     i2c_id: exit_i2c
#     address: 0x39
#     update_interval: 100ms
#     ambient_light_gain: 4x
#
# sensor:
#   # The entry sensor is intentionally proximity-only.
#   - platform: apds9960
#     apds9960_id: entry_apds
#     type: PROXIMITY
#     id: entry_proximity
#     name: Entry Proximity
#
#   - platform: apds9960
#     apds9960_id: exit_apds
#     type: PROXIMITY
#     id: exit_proximity
#     name: Exit Proximity
#
#   # ESPHome scales each APDS9960 color ADC channel independently to a
#   # percentage of 65535. These are not RGB-mix percentages. Only publish
#   # RGBC after the object has stopped in the close-range capture window and
#   # a full 200ms integration has had time to complete. Throttle active color
#   # telemetry to 4Hz per channel.
#   - platform: apds9960
#     apds9960_id: exit_apds
#     type: RED
#     id: exit_red
#     name: Exit Red
#     filters:
#       - lambda: |-
#           if (!id(exit_color_ready).state) return {};
#           return x;
#       - throttle: 250ms
#   - platform: apds9960
#     apds9960_id: exit_apds
#     type: GREEN
#     id: exit_green
#     name: Exit Green
#     filters:
#       - lambda: |-
#           if (!id(exit_color_ready).state) return {};
#           return x;
#       - throttle: 250ms
#   - platform: apds9960
#     apds9960_id: exit_apds
#     type: BLUE
#     id: exit_blue
#     name: Exit Blue
#     filters:
#       - lambda: |-
#           if (!id(exit_color_ready).state) return {};
#           return x;
#       - throttle: 250ms
#   - platform: apds9960
#     apds9960_id: exit_apds
#     type: CLEAR
#     id: exit_clear
#     name: Exit Clear
#     filters:
#       - lambda: |-
#           if (!id(exit_color_ready).state) return {};
#           return x;
#       - throttle: 250ms
#
# binary_sensor:
#   - platform: template
#     id: entry_object_present
#     name: Entry Object Present
#     lambda: return id(entry_proximity).has_state() && id(entry_proximity).state >= 20.0;
#   - platform: template
#     id: exit_object_present
#     name: Exit Object Present
#     # Keep the original early-presence threshold for telemetry.
#     lambda: return id(exit_proximity).has_state() && id(exit_proximity).state >= 20.0;
#   - platform: template
#     id: exit_capture_position
#     internal: true
#     # CircuitPython testing showed red/blue separation becomes dependable at
#     # close range. 70% is approximately raw proximity 179 on the APDS9960.
#     lambda: return id(exit_proximity).has_state() && id(exit_proximity).state >= 70.0;
#   - platform: template
#     id: exit_color_ready
#     name: Exit Color Ready
#     # Stop first, then wait long enough for a fresh ~200ms color integration
#     # with the LEGO block stationary in the capture window.
#     lambda: return id(exit_capture_position).state;
#     filters:
#       - delayed_on: 250ms
#   - platform: template
#     id: conveyor_run_request
#     name: Conveyor Run Request
#     # Latch an entry detection until the object reaches the close-range exit
#     # capture position. Returning an empty optional keeps the last published
#     # value between those events.
#     lambda: |-
#       if (id(exit_capture_position).state) return false;
#       if (id(entry_object_present).state) return true;
#       return {};
#
# # The FeatherS2 onboard APA102 uses a dedicated write-only SPI bus.
# spi:
#   - id: status_spi
#     clk_pin: GPIO45
#     mosi_pin: GPIO40
#
# output:
#   # CircuitPython board.D21 -> FeatherS2 GPIO38 -> DRV8833 AIN1.
#   - platform: ledc
#     id: motor_ain1_pwm
#     pin: GPIO38
#     frequency: 20kHz
#   # CircuitPython board.D20 -> FeatherS2 GPIO33 -> DRV8833 AIN2.
#   - platform: ledc
#     id: motor_ain2_pwm
#     pin: GPIO33
#     frequency: 20kHz
#   # CircuitPython board.D5 -> FeatherS2 GPIO1 -> DRV8833 SLP.
#   # Keeping this separate from the H-bridge outputs prevents a latched-fault
#   # start request from briefly waking the driver before the fault check.
#   - platform: gpio
#     id: motor_sleep
#     pin: GPIO1
#
# fan:
#   - platform: hbridge
#     id: conveyor_motor
#     name: Conveyor Motor
#     # Forward matches the tested CircuitPython state:
#     # AIN1/GPIO38 high and AIN2/GPIO33 low.
#     pin_a: motor_ain1_pwm
#     pin_b: motor_ain2_pwm
#     decay_mode: slow
#     speed_count: 100
#     restore_mode: ALWAYS_OFF
#     on_turn_on:
#       - if:
#           condition:
#             lambda: return id(motor_fault);
#           then:
#             - output.turn_off: motor_sleep
#             - logger.log: "Blocked motor start: safety fault is latched"
#             - fan.turn_off: conveyor_motor
#           else:
#             - output.turn_on: motor_sleep
#             - script.execute: motor_runtime_limit
#     on_turn_off:
#       - output.turn_off: motor_sleep
#       - script.stop: motor_runtime_limit
#
# light:
#   - platform: spi_led_strip
#     spi_id: status_spi
#     id: status_light
#     name: Status Light
#     num_leds: 1
#     data_rate: 1MHz
#     restore_mode: ALWAYS_OFF
#
# button:
#   - platform: template
#     id: reset_motor_fault
#     name: Reset Motor Fault
#     on_press:
#       - fan.turn_off: conveyor_motor
#       - output.turn_off: motor_sleep
#       - globals.set:
#           id: motor_fault
#           value: "false"
#       - logger.log: "Motor fault reset while motor is stopped"
#
# script:
#   - id: motor_runtime_limit
#     mode: restart
#     then:
#       - delay: 30s
#       - globals.set:
#           id: motor_fault
#           value: "true"
#       - fan.turn_off: conveyor_motor
#       - logger.log: "Motor stopped: 30 second runtime limit reached"
#
# # Stop and latch locally if the state-subscribed controller disappears while
# # the motor is running. Logger-only API sessions do not satisfy this lease.
# interval:
#   - interval: 500ms
#     then:
#       - if:
#           condition:
#             and:
#               - fan.is_on: conveyor_motor
#               - not:
#                   api.connected:
#                     state_subscription_only: true
#           then:
#             - globals.set:
#                 id: motor_fault
#                 value: "true"
#             - fan.turn_off: conveyor_motor
#             - logger.log: "Motor stopped: native API control lease was lost"

import "fmt"
import "net/esphome"

$endpoint = "esphome-conveyor"
$motor = "Conveyor Motor"
$light = "Status Light"

$entry_present = esphome.binary_sensor($endpoint, "Entry Object Present")
$exit_present = esphome.binary_sensor($endpoint, "Exit Object Present")
$color_ready = esphome.binary_sensor($endpoint, "Exit Color Ready")
$run_request = esphome.binary_sensor($endpoint, "Conveyor Run Request")
$red = esphome.sensor($endpoint, "Exit Red")
$green = esphome.sensor($endpoint, "Exit Green")
$blue = esphome.sensor($endpoint, "Exit Blue")
$clear = esphome.sensor($endpoint, "Exit Clear")

# ESPHome scales every RGBC channel by the same 65535 divisor, so normalizing
# R/G/B by their sum recreates the raw-channel RGB mix used during the
# CircuitPython calibration. Only red and blue are classified here because those
# LEGO samples produced clean, repeatable close-range clusters. Green, yellow,
# and anything outside the calibrated regions are deliberately "unknown".
$rgb_total = $red + $green + $blue
$red_mix = if $rgb_total > 0.0 {
	$red / $rgb_total
} else {
	0.0
}
$green_mix = if $rgb_total > 0.0 {
	$green / $rgb_total
} else {
	0.0
}
$blue_mix = if $rgb_total > 0.0 {
	$blue / $rgb_total
} else {
	0.0
}

$detected_color = if $color_ready {
	if $red_mix >= 0.44 and $green_mix <= 0.27 {
		"red"
	} else {
		if $blue_mix >= 0.39 and $green_mix <= 0.33 {
			"blue"
		} else {
			"unknown"
		}
	}
} else {
	"none"
}

# Keep transit and idle colors distinct from the two calibrated object colors.
# Yellow means the conveyor is carrying an object, white means idle, orange
# means an object reached the color station but did not match red or blue.
$status_color = if $color_ready {
	if $detected_color == "red" {
		"red"
	} else {
		if $detected_color == "blue" {
			"blue"
		} else {
			"orange"
		}
	}
} else {
	if $entry_present {
		"yellow"
	} else {
		"#ffffff"
	}
}

esphome:endpoint $endpoint {
	host => "esphome-conveyor.local",
	# Public sample key: replace it here and in the firmware before real use.
	key => "kJ7hc0lJ0Zw9N3DcJzXn1kJ7hc0lJ0Zw9N3DcJzXn1k=",
	interval => 0,
	logs => "info",
}

esphome:fan $motor {
	endpoint => $endpoint,
	state => if $run_request {
		"on"
	} else {
		"off"
	},
	speed => 35,
	direction => "forward",
	# On a long outage, stop before retrying the desired state. The firmware
	# lease, persistent fault latch, runtime limit, and physical stop remain the
	# authoritative safety layers.
	stop => 5,
	Meta:retry => -1,
	Meta:delay => 5000,
}

esphome:light $light {
	endpoint => $endpoint,
	state => "on",
	brightness => 0.35,
	color => $status_color,
}

print "conveyor telemetry" {
	msg => fmt.printf(
		"entry=%v exit=%v color-ready=%v run=%v exit-rgbc=(%f, %f, %f, %f) mix=(%f, %f, %f) detected=%s status=%s",
		$entry_present,
		$exit_present,
		$color_ready,
		$run_request,
		$red,
		$green,
		$blue,
		$clear,
		$red_mix,
		$green_mix,
		$blue_mix,
		$detected_color,
		$status_color,
	),
}

Esphome:Endpoint[$endpoint] -> Esphome:Fan[$motor]
Esphome:Endpoint[$endpoint] -> Esphome:Light[$light]
